<Window x:Class="UiShowcase.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="澄明界面展示 - 确认操作"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource BgSurfaceBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        RenderOptions.ClearTypeHint="Enabled"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AutomationProperties.AutomationId="ConfirmDialogWindow"
        AutomationProperties.Name="确认操作弹窗">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText"
                   Grid.Row="0"
                   Style="{StaticResource H2TextStyle}"
                   Margin="0,0,0,10" />

        <TextBlock x:Name="MessageText"
                   Grid.Row="1"
                   Style="{StaticResource BodyTextStyle}"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Margin="0,0,0,20" />

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="CancelBtn"
                    Content="取消"
                    IsCancel="True"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,0,8,0"
                    MinWidth="84"
                    Click="CancelBtn_Click"
                    AutomationProperties.AutomationId="ConfirmDialogCancelButton"
                    AutomationProperties.Name="取消" />
            <Button x:Name="ConfirmBtn"
                    Content="确认"
                    Style="{StaticResource DangerButtonStyle}"
                    MinWidth="88"
                    Click="ConfirmBtn_Click"
                    AutomationProperties.AutomationId="ConfirmDialogConfirmButton"
                    AutomationProperties.Name="确认移除" />
        </StackPanel>
    </Grid>
</Window>
