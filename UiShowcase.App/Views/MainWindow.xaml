<Window x:Class="UiShowcase.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pages="clr-namespace:UiShowcase.Views.Pages"
        Title="澄明界面展示"
        Icon="pack://application:,,,/Assets/app.ico"
        MinWidth="820"
        MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgCanvasBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFontFamily}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        RenderOptions.ClearTypeHint="Enabled"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AutomationProperties.AutomationId="MainAppWindow"
        AutomationProperties.Name="澄明界面展示">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{DynamicResource NavWidth}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧导航栏 -->
        <Border Grid.Column="0"
                Background="{DynamicResource BgCanvasBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,0,1,0">
            <Grid Margin="16,20,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 品牌标识区 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="6,0,6,24" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/app.ico"
                           Width="28"
                           Height="28"
                           Margin="0,0,12,0"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="澄明界面展示"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,2" />
                        <TextBlock Text="原生工具风设计规范"
                                   Style="{StaticResource CaptionTextStyle}"
                                   FontSize="12" />
                    </StackPanel>
                </StackPanel>

                <!-- 导航项 -->
                <StackPanel Grid.Row="1"
                            AutomationProperties.AutomationId="MainNavigationPanel"
                            AutomationProperties.Name="主导航栏">
                    <RadioButton Content="总览与色板"
                                 GroupName="MainNav"
                                 IsChecked="{Binding IsOverviewPage}"
                                 Style="{StaticResource NavItemRadioStyle}"
                                 AutomationProperties.AutomationId="NavOverviewButton"
                                 AutomationProperties.Name="导航：总览与色板" />
                    <RadioButton Content="典型工具界面"
                                 GroupName="MainNav"
                                 IsChecked="{Binding IsWorkbenchPage}"
                                 Style="{StaticResource NavItemRadioStyle}"
                                 AutomationProperties.AutomationId="NavWorkbenchButton"
                                 AutomationProperties.Name="导航：典型工具界面" />
                    <RadioButton Content="控件与交互态"
                                 GroupName="MainNav"
                                 IsChecked="{Binding IsControlsPage}"
                                 Style="{StaticResource NavItemRadioStyle}"
                                 AutomationProperties.AutomationId="NavControlsButton"
                                 AutomationProperties.Name="导航：控件与交互态" />

                    <Border Style="{StaticResource SubtleDividerStyle}" Margin="6,14" />

                    <RadioButton Content="主题与设置"
                                 GroupName="MainNav"
                                 IsChecked="{Binding IsSettingsPage}"
                                 Style="{StaticResource NavItemRadioStyle}"
                                 AutomationProperties.AutomationId="NavSettingsButton"
                                 AutomationProperties.Name="导航：主题与设置" />
                    <RadioButton Content="关于与环境"
                                 GroupName="MainNav"
                                 IsChecked="{Binding IsAboutPage}"
                                 Style="{StaticResource NavItemRadioStyle}"
                                 AutomationProperties.AutomationId="NavAboutButton"
                                 AutomationProperties.Name="导航：关于与环境" />
                </StackPanel>

                <!-- 底部提示与快捷退出 -->
                <StackPanel Grid.Row="2">
                    <Border Background="{DynamicResource BgSurfaceBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,10"
                            Margin="0,0,0,12">
                        <TextBlock Text="提示：按 Tab 键可观察统一的 2px 键盘焦点外描边。"
                                   Style="{StaticResource CaptionTextStyle}"
                                   LineHeight="19"
                                   TextWrapping="Wrap" />
                    </Border>
                    <Button Content="退出应用"
                            Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Click="ExitButton_Click"
                            AutomationProperties.AutomationId="NavExitButton"
                            AutomationProperties.Name="退出应用" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 右侧主工作区 + 顶部上下文栏 + 底部状态栏 -->
        <Grid Grid.Column="1" Background="{DynamicResource BgCanvasBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 顶部页面标题与即时预览开关 -->
            <Border Grid.Row="0"
                    Background="{DynamicResource BgSurfaceBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="{DynamicResource HeaderPadding}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                        <TextBlock Text="{Binding CurrentPageTitle}"
                                   Style="{StaticResource H1TextStyle}"
                                   AutomationProperties.AutomationId="CurrentPageTitleText" />
                        <TextBlock Text="{Binding CurrentPageSubtitle}"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   Margin="0,5,0,0" />
                    </StackPanel>

                    <!-- 顶部快速体验控件：一键切换密度与浅/深主题 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource BgControlAltBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="2"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="标准"
                                             GroupName="TopDensityGroup"
                                             IsChecked="{Binding IsDensityStandard}"
                                             Style="{StaticResource SegmentRadioStyle}"
                                             Padding="14,6,14,8"
                                             AutomationProperties.AutomationId="TopDensityStandardRadio"
                                             AutomationProperties.Name="快速切换：标准密度" />
                                <RadioButton Content="紧凑"
                                             GroupName="TopDensityGroup"
                                             IsChecked="{Binding IsDensityCompact}"
                                             Style="{StaticResource SegmentRadioStyle}"
                                             Padding="14,6,14,8"
                                             AutomationProperties.AutomationId="TopDensityCompactRadio"
                                             AutomationProperties.Name="快速切换：紧凑密度" />
                            </StackPanel>
                        </Border>

                        <Button Content="切换浅/深色"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding QuickToggleThemeCommand}"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="TopQuickThemeButton"
                                AutomationProperties.Name="快速切换浅色或深色主题" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 页面内容承载区 -->
            <Grid Grid.Row="1">
                <pages:OverviewPage Visibility="{Binding IsOverviewPage, Converter={StaticResource BoolToVis}}" />
                <pages:WorkbenchPage Visibility="{Binding IsWorkbenchPage, Converter={StaticResource BoolToVis}}" />
                <pages:ControlsPage Visibility="{Binding IsControlsPage, Converter={StaticResource BoolToVis}}" />
                <pages:SettingsPage Visibility="{Binding IsSettingsPage, Converter={StaticResource BoolToVis}}" />
                <pages:AboutPage Visibility="{Binding IsAboutPage, Converter={StaticResource BoolToVis}}" />
            </Grid>

            <!-- 底部状态栏 -->
            <Border Grid.Row="2"
                    Background="{DynamicResource BgSurfaceBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="{DynamicResource StatusBarPadding}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding StatusMessage}"
                               Style="{StaticResource CaptionTextStyle}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Margin="0,0,0,2"
                               AutomationProperties.AutomationId="MainStatusBarText"
                               AutomationProperties.LiveSetting="Polite" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,2">
                        <TextBlock Text="{Binding EffectiveThemeLabel}"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Margin="12,0,0,0" />
                        <TextBlock Text="·" Style="{StaticResource CaptionTextStyle}" Margin="8,0" />
                        <TextBlock Text="{Binding DensityLabel}"
                                   Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
