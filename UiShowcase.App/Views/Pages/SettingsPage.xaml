<UserControl x:Class="UiShowcase.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.AutomationId="SettingsPageRoot"
             AutomationProperties.Name="主题与设置页面">
    <ScrollViewer Background="{DynamicResource BgCanvasBrush}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="{DynamicResource PagePadding}">
            <!-- 外观与主题设置 -->
            <Border Style="{StaticResource SurfaceCardStyle}" Margin="{DynamicResource SectionMargin}">
                <StackPanel>
                    <TextBlock Text="外观与排版" Style="{StaticResource H2TextStyle}" Margin="0,0,0,18" />

                    <!-- 主题模式 -->
                    <DockPanel Margin="0,0,0,18">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="主题模式" Style="{StaticResource H3TextStyle}" Margin="0,0,0,3" />
                            <TextBlock Text="支持浅色、深色以及跟随 Windows 系统外观自动切换" Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                        <Border DockPanel.Dock="Right"
                                Background="{DynamicResource BgControlAltBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="3"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="跟随系统"
                                             GroupName="SettingsThemeGroup"
                                             IsChecked="{Binding IsThemeSystem}"
                                             Style="{StaticResource SegmentRadioStyle}"
                                             AutomationProperties.AutomationId="SettingsThemeSystemRadio"
                                             AutomationProperties.Name="主题模式：跟随系统" />
                                <RadioButton Content="浅色模式"
                                             GroupName="SettingsThemeGroup"
                                             IsChecked="{Binding IsThemeLight}"
                                             Style="{StaticResource SegmentRadioStyle}"
                                             AutomationProperties.AutomationId="SettingsThemeLightRadio"
                                             AutomationProperties.Name="主题模式：浅色模式" />
                                <RadioButton Content="深色模式"
                                             GroupName="SettingsThemeGroup"
                                             IsChecked="{Binding IsThemeDark}"
                                             Style="{StaticResource SegmentRadioStyle}"
                                             AutomationProperties.AutomationId="SettingsThemeDarkRadio"
                                             AutomationProperties.Name="主题模式：深色模式" />
                            </StackPanel>
                        </Border>
                    </DockPanel>

                    <Border Style="{StaticResource SubtleDividerStyle}" Margin="0,0,0,18" />

                    <!-- 强调色 -->
                    <DockPanel Margin="0,0,0,18">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="品牌强调色" Style="{StaticResource H3TextStyle}" Margin="0,0,0,3" />
                            <TextBlock Text="仅替换 1 组强调色 Token，即可为不同工具建立清晰辨识度" Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                        <Border DockPanel.Dock="Right"
                                Background="{DynamicResource BgControlAltBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="3"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="澄明蓝"
                                             GroupName="SettingsAccentGroup"
                                             IsChecked="{Binding IsAccentBlue}"
                                             Style="{StaticResource SegmentRadioStyle}"
                                             AutomationProperties.AutomationId="SettingsAccentBlueRadio"
                                             AutomationProperties.Name="强调色：澄明蓝" />
                                <RadioButton Content="青瓷绿"
                                             GroupName="SettingsAccentGroup"
                                             IsChecked="{Binding IsAccentTeal}"
                                             Style="{StaticResource SegmentRadioStyle}"
                                             AutomationProperties.AutomationId="SettingsAccentTealRadio"
                                             AutomationProperties.Name="强调色：青瓷绿" />
                                <RadioButton Content="暮山紫"
                                             GroupName="SettingsAccentGroup"
                                             IsChecked="{Binding IsAccentIndigo}"
                                             Style="{StaticResource SegmentRadioStyle}"
                                             AutomationProperties.AutomationId="SettingsAccentIndigoRadio"
                                             AutomationProperties.Name="强调色：暮山紫" />
                                <RadioButton Content="琥珀金"
                                             GroupName="SettingsAccentGroup"
                                             IsChecked="{Binding IsAccentAmber}"
                                             Style="{StaticResource SegmentRadioStyle}"
                                             AutomationProperties.AutomationId="SettingsAccentAmberRadio"
                                             AutomationProperties.Name="强调色：琥珀金" />
                            </StackPanel>
                        </Border>
                    </DockPanel>

                    <Border Style="{StaticResource SubtleDividerStyle}" Margin="0,0,0,18" />

                    <!-- 界面密度 -->
                    <DockPanel>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="界面密度" Style="{StaticResource H3TextStyle}" Margin="0,0,0,3" />
                            <TextBlock Text="标准密度舒展从容；紧凑密度适合信息密集的列表与表格工具" Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                        <Border DockPanel.Dock="Right"
                                Background="{DynamicResource BgControlAltBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="3"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="标准密度"
                                             GroupName="SettingsDensityGroup"
                                             IsChecked="{Binding IsDensityStandard}"
                                             Style="{StaticResource SegmentRadioStyle}"
                                             AutomationProperties.AutomationId="SettingsDensityStandardRadio"
                                             AutomationProperties.Name="界面密度：标准密度" />
                                <RadioButton Content="紧凑密度"
                                             GroupName="SettingsDensityGroup"
                                             IsChecked="{Binding IsDensityCompact}"
                                             Style="{StaticResource SegmentRadioStyle}"
                                             AutomationProperties.AutomationId="SettingsDensityCompactRadio"
                                             AutomationProperties.Name="界面密度：紧凑密度" />
                            </StackPanel>
                        </Border>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- 窗口与系统集成 -->
            <Border Style="{StaticResource SurfaceCardStyle}" Margin="{DynamicResource SectionMargin}">
                <StackPanel>
                    <TextBlock Text="托盘与系统启动" Style="{StaticResource H2TextStyle}" Margin="0,0,0,16" />

                    <CheckBox Content="关闭主窗口时隐藏到系统托盘（通过托盘菜单「退出」可彻底关闭）"
                              IsChecked="{Binding CloseToTray}"
                              Style="{StaticResource ToggleSwitchStyle}"
                              Margin="0,0,0,16"
                              AutomationProperties.AutomationId="SettingsCloseToTrayToggle"
                              AutomationProperties.Name="关闭主窗口时隐藏到系统托盘" />

                    <CheckBox Content="登录时启动（同步写入当前用户启动项注册表）"
                              IsChecked="{Binding AutoStartEnabled}"
                              Style="{StaticResource ToggleSwitchStyle}"
                              Margin="0,0,0,16"
                              AutomationProperties.AutomationId="SettingsAutoStartToggle"
                              AutomationProperties.Name="登录时启动" />

                    <CheckBox Content="登录启动时默认隐藏到系统托盘（启动参数附带 --minimized）"
                              IsChecked="{Binding StartMinimizedOnAutoStart}"
                              Style="{StaticResource ToggleSwitchStyle}"
                              Margin="0,0,0,16"
                              AutomationProperties.AutomationId="SettingsStartMinimizedToggle"
                              AutomationProperties.Name="登录启动时默认隐藏到系统托盘" />

                    <Border Background="{DynamicResource BgCanvasBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="当前登录启动项注册状态：" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding AutoStartCommandPreview}"
                                       Style="{StaticResource MonoTextStyle}"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="SettingsAutoStartCommandText" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 配置存储与重置 -->
            <Border Style="{StaticResource SurfaceCardStyle}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,14">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="配置文件与恢复默认" Style="{StaticResource H2TextStyle}" />
                            <TextBlock Text="{Binding SettingsPath, StringFormat='存储位置：{0}'}"
                                       Style="{StaticResource MonoTextStyle}"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,5,0,0" />
                        </StackPanel>
                        <Button DockPanel.Dock="Right"
                                Content="恢复默认设置"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding ResetSettingsCommand}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="SettingsResetButton"
                                AutomationProperties.Name="恢复默认设置" />
                    </DockPanel>

                    <Border Background="{DynamicResource StatusInfoBgBrush}"
                            BorderBrush="{DynamicResource StatusInfoBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="14,10">
                        <TextBlock Text="{Binding SettingsFeedbackText}"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,0,2"
                                   AutomationProperties.AutomationId="SettingsFeedbackText"
                                   AutomationProperties.LiveSetting="Polite" />
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
