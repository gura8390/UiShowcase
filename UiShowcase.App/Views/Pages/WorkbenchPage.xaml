<UserControl x:Class="UiShowcase.Views.Pages.WorkbenchPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.AutomationId="WorkbenchPageRoot"
             AutomationProperties.Name="典型工具界面页面">
    <UserControl.Resources>
        <Style x:Key="StatusBadgeBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource StatusInfoBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StatusInfoBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusKind}" Value="Success">
                    <Setter Property="Background" Value="{DynamicResource StatusSuccessBgBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource StatusSuccessBorderBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="Warning">
                    <Setter Property="Background" Value="{DynamicResource StatusWarningBgBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource StatusWarningBorderBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="Danger">
                    <Setter Property="Background" Value="{DynamicResource StatusDangerBgBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource StatusDangerBorderBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusBadgeTextStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource StatusInfoBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusKind}" Value="Success">
                    <Setter Property="Foreground" Value="{DynamicResource StatusSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="Warning">
                    <Setter Property="Foreground" Value="{DynamicResource StatusWarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="Danger">
                    <Setter Property="Foreground" Value="{DynamicResource StatusDangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="{DynamicResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部工具栏 -->
        <Border Grid.Row="0" Style="{StaticResource SurfaceCardStyle}" Padding="18,14" Margin="{DynamicResource RowMargin}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="开始模拟核查"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding StartScanCommand}"
                            Margin="0,0,10,0"
                            AutomationProperties.AutomationId="WorkbenchStartScanButton"
                            AutomationProperties.Name="开始模拟核查" />
                    <Button Content="取消任务"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding CancelScanCommand}"
                            Margin="0,0,10,0"
                            AutomationProperties.AutomationId="WorkbenchCancelScanButton"
                            AutomationProperties.Name="取消任务" />
                    <Button Content="{Binding EmptyStateButtonText}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ToggleEmptyStateCommand}"
                            Margin="0,0,10,0"
                            AutomationProperties.AutomationId="WorkbenchToggleEmptyButton"
                            AutomationProperties.Name="切换空状态演示" />
                    <Button Content="重置数据"
                            Style="{StaticResource GhostButtonStyle}"
                            Command="{Binding ResetSampleTasksCommand}"
                            AutomationProperties.AutomationId="WorkbenchResetButton"
                            AutomationProperties.Name="重置演示数据" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox Width="128"
                              ItemsSource="{Binding StatusFilterOptions}"
                              SelectedItem="{Binding SelectedStatusFilter}"
                              Style="{StaticResource ModernComboBoxStyle}"
                              Margin="0,0,10,0"
                              AutomationProperties.AutomationId="WorkbenchStatusFilterCombo"
                              AutomationProperties.Name="按状态筛选" />
                    <TextBox Width="220"
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             Tag="搜索文件名、路径或编号..."
                             Style="{StaticResource ModernTextBoxStyle}"
                             AutomationProperties.AutomationId="WorkbenchSearchBox"
                             AutomationProperties.Name="搜索核查记录" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 进度与汇总栏 -->
        <Border Grid.Row="1"
                Style="{StaticResource SurfaceCardStyle}"
                Padding="18,12"
                Margin="{DynamicResource RowMargin}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="210" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding TaskSummaryText}"
                           Style="{StaticResource SecondaryTextStyle}"
                           VerticalAlignment="Center"
                           Margin="0,0,0,2" />
                <ProgressBar Grid.Column="1"
                             Value="{Binding ScanProgress}"
                             Maximum="100"
                             Style="{StaticResource ModernProgressBarStyle}"
                             Margin="16,0"
                             VerticalAlignment="Center"
                             AutomationProperties.AutomationId="WorkbenchScanProgressBar"
                             AutomationProperties.Name="核查任务进度" />
                <TextBlock Grid.Column="2"
                           Text="{Binding ScanProgressText}"
                           Style="{StaticResource MonoTextStyle}"
                           FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,0,2"
                           AutomationProperties.LiveSetting="Polite" />
            </Grid>
        </Border>

        <!-- 主区：左侧列表 + 右侧详情面板 / 空状态 -->
        <Grid Grid.Row="2">
            <!-- 数据列表 + 详情 -->
            <Grid Visibility="{Binding ShowTaskList, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="2*" MinWidth="290" />
                </Grid.ColumnDefinitions>

                <!-- 左侧列表卡片 -->
                <Border Grid.Column="0" Style="{StaticResource SurfaceCardStyle}" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 表头 -->
                        <Grid Grid.Row="0" Margin="14,4,14,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="82" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="86" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="编号" Style="{StaticResource CaptionTextStyle}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="文件名称与位置" Style="{StaticResource CaptionTextStyle}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="大小" Style="{StaticResource CaptionTextStyle}" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,0,12,0" />
                            <TextBlock Grid.Column="3" Text="状态" Style="{StaticResource CaptionTextStyle}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        </Grid>

                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding FilteredTaskItems}"
                                 SelectedItem="{Binding SelectedTaskItem}"
                                 Background="{DynamicResource BgSurfaceBrush}"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ItemContainerStyle="{StaticResource ModernListBoxItemStyle}"
                                 AutomationProperties.AutomationId="WorkbenchTaskList"
                                 AutomationProperties.Name="核查记录列表">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="82" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="92" />
                                            <ColumnDefinition Width="86" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Id}"
                                                   Style="{StaticResource MonoTextStyle}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,0,2" />
                                        <StackPanel Grid.Column="1" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileName}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding FileName}"
                                                       Margin="0,0,0,2" />
                                            <TextBlock Text="{Binding FolderPath}"
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding FolderPath}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding SizeText}"
                                                   Style="{StaticResource MonoTextStyle}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,12,2" />
                                        <Border Grid.Column="3"
                                                Style="{StaticResource StatusBadgeBorderStyle}"
                                                CornerRadius="5"
                                                Padding="10,2,10,4"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Status}"
                                                       Style="{StaticResource StatusBadgeTextStyle}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- 右侧选中项详情面板 -->
                <Border Grid.Column="2" Style="{StaticResource SurfaceCardStyle}">
                    <Grid DataContext="{Binding SelectedTaskItem}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="选中记录详情" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding FileName}" Style="{StaticResource H2TextStyle}" />
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" Background="{DynamicResource BgSurfaceBrush}" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Style="{StaticResource SubtleDividerStyle}" Margin="0,0,0,10" />

                                <TextBlock Text="记录编号" Style="{StaticResource CaptionTextStyle}" />
                                <TextBlock Text="{Binding Id}" Style="{StaticResource MonoTextStyle}" Margin="0,2,0,8" />

                                <TextBlock Text="所在目录" Style="{StaticResource CaptionTextStyle}" />
                                <TextBlock Text="{Binding FolderPath}" Style="{StaticResource MonoTextStyle}" TextWrapping="Wrap" Margin="0,2,0,8" />

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="文件大小" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBlock Text="{Binding SizeText}" Style="{StaticResource MonoTextStyle}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="哈希摘要" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBlock Text="{Binding ShaShort}" Style="{StaticResource MonoTextStyle}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="修改时间" Style="{StaticResource CaptionTextStyle}" />
                                <TextBlock Text="{Binding ModifiedAt}" Style="{StaticResource MonoTextStyle}" Margin="0,2,0,12" />

                                <Border Style="{StaticResource StatusBadgeBorderStyle}"
                                        CornerRadius="6"
                                        Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Status, StringFormat='核查结论：{0}'}"
                                                   Style="{StaticResource StatusBadgeTextStyle}"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"
                                                   Margin="0,0,0,4" />
                                        <TextBlock Text="{Binding DetailNote}"
                                                   Style="{StaticResource SecondaryTextStyle}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel Grid.Row="2" Margin="0,12,0,0">
                            <Border Style="{StaticResource SubtleDividerStyle}" Margin="0,0,0,12" />
                            <Button Content="移除选中记录（演示二次确认）"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Command="{Binding DataContext.DeleteSelectedTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.AutomationId="WorkbenchDeleteButton"
                                    AutomationProperties.Name="移除选中记录" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- 空状态规范演示 -->
            <Border Style="{StaticResource SurfaceCardStyle}"
                    Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVis}}"
                    AutomationProperties.AutomationId="WorkbenchEmptyStatePanel"
                    AutomationProperties.Name="空状态面板">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
                    <Border Width="56"
                            Height="56"
                            CornerRadius="28"
                            Background="{DynamicResource AccentSubtleBrush}"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,16">
                        <TextBlock Text="空"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentPrimaryBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="0,0,0,2" />
                    </Border>
                    <TextBlock Text="当前没有符合条件的核查记录"
                               Style="{StaticResource H2TextStyle}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10" />
                    <TextBlock Text="规范要求空状态必须说明当前为空的原因，并直接给出明确的下一步操作入口，避免用户面对一片空白。"
                               Style="{StaticResource SecondaryTextStyle}"
                               TextAlignment="Center"
                               Margin="0,0,0,20" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="恢复示例列表"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding ResetSampleTasksCommand}"
                                Margin="0,0,12,0"
                                AutomationProperties.AutomationId="EmptyStateRestoreButton"
                                AutomationProperties.Name="恢复示例列表" />
                        <Button Content="开始模拟核查"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding StartScanCommand}"
                                AutomationProperties.AutomationId="EmptyStateScanButton"
                                AutomationProperties.Name="开始模拟核查" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
