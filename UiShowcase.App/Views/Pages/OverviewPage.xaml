<UserControl x:Class="UiShowcase.Views.Pages.OverviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.AutomationId="OverviewPageRoot"
             AutomationProperties.Name="总览与色板页面">
    <ScrollViewer Background="{DynamicResource BgCanvasBrush}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="{DynamicResource PagePadding}">
            <!-- 核心设计原则四卡片（更舒展的卡片间距与内边距） -->
            <UniformGrid Columns="4" Margin="{DynamicResource SectionMargin}">
                <Border Style="{StaticResource SurfaceCardStyle}" Margin="0,0,14,0">
                    <StackPanel>
                        <TextBlock Text="01 · 舒展留白" Style="{StaticResource H3TextStyle}" Margin="0,0,0,8" />
                        <TextBlock Text="以充分留白与清晰网格组织信息，兼顾标准与紧凑两档密度，长时间操作依然从容。"
                                   Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SurfaceCardStyle}" Margin="0,0,14,0">
                    <StackPanel>
                        <TextBlock Text="02 · 色阶分层" Style="{StaticResource H3TextStyle}" Margin="0,0,0,8" />
                        <TextBlock Text="常规区域通过背景色差与 1px 细边框自然区分层级，仅在浮层/弹窗使用极轻阴影。"
                                   Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SurfaceCardStyle}" Margin="0,0,14,0">
                    <StackPanel>
                        <TextBlock Text="03 · 语义双主题" Style="{StaticResource H3TextStyle}" Margin="0,0,0,8" />
                        <TextBlock Text="全界面基于语义 Token 渲染，一键切换浅色、深色、强调色，并自动回退系统高对比度。"
                                   Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SurfaceCardStyle}">
                    <StackPanel>
                        <TextBlock Text="04 · 无障碍内建" Style="{StaticResource H3TextStyle}" Margin="0,0,0,8" />
                        <TextBlock Text="全控件五态闭环、视觉基线居中校准与统一 2px 键盘焦点外描边，兼顾观感与可读性。"
                                   Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- 语义色板 -->
            <Border Style="{StaticResource SurfaceCardStyle}" Margin="{DynamicResource SectionMargin}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,16">
                        <TextBlock Text="语义色板（随浅色 / 深色与强调色实时刷新）"
                                   Style="{StaticResource H2TextStyle}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding EffectiveThemeLabel, StringFormat='当前生效：{0}'}"
                                   Style="{StaticResource CaptionTextStyle}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </DockPanel>

                    <ItemsControl ItemsSource="{Binding TokenItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="252"
                                        Margin="0,0,14,14"
                                        Padding="14"
                                        CornerRadius="6"
                                        Background="{DynamicResource BgCanvasBrush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="30"
                                                Height="30"
                                                CornerRadius="5"
                                                VerticalAlignment="Top"
                                                Margin="0,2,0,0"
                                                Background="{Binding BrushKey, Converter={StaticResource ResourceBrushConverter}}"
                                                BorderBrush="{DynamicResource BorderControlBrush}"
                                                BorderThickness="1" />
                                        <StackPanel Grid.Column="1">
                                            <DockPanel>
                                                <TextBlock Text="{Binding DisplayName}"
                                                           Style="{StaticResource H3TextStyle}"
                                                           FontSize="14" />
                                                <TextBlock Text="{Binding HexValue}"
                                                           Style="{StaticResource MonoTextStyle}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding TokenName}"
                                                       Style="{StaticResource MonoTextStyle}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource AccentPrimaryBrush}"
                                                       Margin="0,3,0,5" />
                                            <TextBlock Text="{Binding Usage}"
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       LineHeight="19"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 排版与数据对齐展示 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource SurfaceCardStyle}">
                    <StackPanel>
                        <TextBlock Text="中文界面字体层级（Microsoft YaHei UI）" Style="{StaticResource H2TextStyle}" Margin="0,0,0,14" />
                        <TextBlock Text="H1 页面主标题 · 24px SemiBold" Style="{StaticResource H1TextStyle}" Margin="0,0,0,10" />
                        <TextBlock Text="H2 分区标题 · 18px SemiBold" Style="{StaticResource H2TextStyle}" Margin="0,0,0,10" />
                        <TextBlock Text="H3 分组与卡片标题 · 16px SemiBold" Style="{StaticResource H3TextStyle}" Margin="0,0,0,10" />
                        <TextBlock Text="Body 正文与表单文字 · 14px，原生屏显锐利清晰，全偶数 DIP 与硬件 ClearType 严格对齐。"
                                   Style="{StaticResource BodyTextStyle}" Margin="0,0,0,10" />
                        <TextBlock Text="Secondary 辅助说明文字 · 14px，用于参数解释、副标题与次要上下文。"
                                   Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,8" />
                        <TextBlock Text="Caption 注释与状态栏文字 · 12px"
                                   Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource SurfaceCardStyle}">
                    <StackPanel>
                        <TextBlock Text="等宽数据排版（Cascadia Mono + 等宽数字）" Style="{StaticResource H2TextStyle}" Margin="0,0,0,14" />
                        <TextBlock Text="数值、哈希、路径、时间戳强制使用等宽字体，确保列表与日志严格纵向对齐："
                                   Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,12" />
                        <Border Background="{DynamicResource BgCanvasBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="14">
                            <StackPanel>
                                <TextBlock Text="编号        大小         校验摘要     更新时间"
                                           Style="{StaticResource MonoTextStyle}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,0,8" />
                                <Border Style="{StaticResource SubtleDividerStyle}" Margin="0,0,0,8" />
                                <TextBlock Text="DOC-001      1.42 MB    A8F3-91C2    2026-11-24 09:18"
                                           Style="{StaticResource MonoTextStyle}" Margin="0,0,0,6" />
                                <TextBlock Text="DOC-002     48.60 KB    4C19-DE07    2026-11-24 11:04"
                                           Style="{StaticResource MonoTextStyle}" Margin="0,0,0,6" />
                                <TextBlock Text="DOC-003     12.15 KB    7B2E-04FA    2026-11-22 17:40"
                                           Style="{StaticResource MonoTextStyle}" Margin="0,0,0,6" />
                                <TextBlock Text="DOC-004     18.75 MB    F05D-88B1    2026-11-20 14:22"
                                           Style="{StaticResource MonoTextStyle}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
