<Application x:Class="UiShowcase.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:UiShowcase"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.Light.xaml" />
                <ResourceDictionary Source="Themes/Density.Standard.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <local:BoolToVisibilityConverter x:Key="BoolToVis" />
            <local:BoolToVisibilityConverter x:Key="InvertBoolToVis" Invert="True" />
            <local:ResourceBrushConverter x:Key="ResourceBrushConverter" />
            <local:StatusKindToBrushConverter x:Key="StatusFgConverter" Role="Foreground" />
            <local:StatusKindToBrushConverter x:Key="StatusBgConverter" Role="Background" />
            <local:StatusKindToBrushConverter x:Key="StatusBorderConverter" Role="Border" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
