<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 澄明原生工具风 · 浅色主题语义色板 -->
    <Color x:Key="BgCanvasColor">#F6F7F9</Color>
    <Color x:Key="BgSurfaceColor">#FFFFFF</Color>
    <Color x:Key="BgElevatedColor">#FFFFFF</Color>
    <Color x:Key="BgControlColor">#FFFFFF</Color>
    <Color x:Key="BgControlAltColor">#F0F2F5</Color>
    <Color x:Key="BgHoverColor">#EEF1F5</Color>
    <Color x:Key="BgPressedColor">#E2E7EE</Color>
    <Color x:Key="BgSelectedColor">#E6F1FB</Color>
    <Color x:Key="BgDisabledColor">#F3F4F6</Color>

    <Color x:Key="TextPrimaryColor">#14171A</Color>
    <Color x:Key="TextSecondaryColor">#424A53</Color>
    <Color x:Key="TextMutedColor">#59636E</Color>
    <Color x:Key="TextDisabledColor">#9AA4B2</Color>
    <Color x:Key="TextOnAccentColor">#FFFFFF</Color>

    <Color x:Key="BorderSubtleColor">#E5E8EC</Color>
    <Color x:Key="BorderControlColor">#CFD5DD</Color>
    <Color x:Key="BorderStrongColor">#9AA4B2</Color>

    <Color x:Key="AccentPrimaryColor">#0F6CBD</Color>
    <Color x:Key="AccentHoverColor">#115EA3</Color>
    <Color x:Key="AccentPressedColor">#0C4B85</Color>
    <Color x:Key="AccentSubtleColor">#EBF4FC</Color>

    <Color x:Key="StatusSuccessColor">#107C10</Color>
    <Color x:Key="StatusSuccessBgColor">#EAF6EC</Color>
    <Color x:Key="StatusSuccessBorderColor">#B7DFBF</Color>

    <Color x:Key="StatusWarningColor">#9D5D00</Color>
    <Color x:Key="StatusWarningBgColor">#FFF4CE</Color>
    <Color x:Key="StatusWarningBorderColor">#EED27B</Color>

    <Color x:Key="StatusDangerColor">#C42B1C</Color>
    <Color x:Key="StatusDangerHoverColor">#A4261A</Color>
    <Color x:Key="StatusDangerPressedColor">#8A1F15</Color>
    <Color x:Key="StatusDangerBgColor">#FDE7E9</Color>
    <Color x:Key="StatusDangerBorderColor">#F1B8BD</Color>

    <Color x:Key="StatusInfoColor">#0F6CBD</Color>
    <Color x:Key="StatusInfoBgColor">#EBF4FC</Color>
    <Color x:Key="StatusInfoBorderColor">#B9D7F3</Color>

    <Color x:Key="FocusRingColor">#0F6CBD</Color>
    <Color x:Key="OverlayScrimColor">#40000000</Color>

    <SolidColorBrush x:Key="BgCanvasBrush" Color="{StaticResource BgCanvasColor}" />
    <SolidColorBrush x:Key="BgSurfaceBrush" Color="{StaticResource BgSurfaceColor}" />
    <SolidColorBrush x:Key="BgElevatedBrush" Color="{StaticResource BgElevatedColor}" />
    <SolidColorBrush x:Key="BgControlBrush" Color="{StaticResource BgControlColor}" />
    <SolidColorBrush x:Key="BgControlAltBrush" Color="{StaticResource BgControlAltColor}" />
    <SolidColorBrush x:Key="BgHoverBrush" Color="{StaticResource BgHoverColor}" />
    <SolidColorBrush x:Key="BgPressedBrush" Color="{StaticResource BgPressedColor}" />
    <SolidColorBrush x:Key="BgSelectedBrush" Color="{StaticResource BgSelectedColor}" />
    <SolidColorBrush x:Key="BgDisabledBrush" Color="{StaticResource BgDisabledColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="{StaticResource TextOnAccentColor}" />

    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}" />
    <SolidColorBrush x:Key="BorderControlBrush" Color="{StaticResource BorderControlColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />

    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="{StaticResource AccentPrimaryColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="{StaticResource AccentSubtleColor}" />

    <SolidColorBrush x:Key="StatusSuccessBrush" Color="{StaticResource StatusSuccessColor}" />
    <SolidColorBrush x:Key="StatusSuccessBgBrush" Color="{StaticResource StatusSuccessBgColor}" />
    <SolidColorBrush x:Key="StatusSuccessBorderBrush" Color="{StaticResource StatusSuccessBorderColor}" />

    <SolidColorBrush x:Key="StatusWarningBrush" Color="{StaticResource StatusWarningColor}" />
    <SolidColorBrush x:Key="StatusWarningBgBrush" Color="{StaticResource StatusWarningBgColor}" />
    <SolidColorBrush x:Key="StatusWarningBorderBrush" Color="{StaticResource StatusWarningBorderColor}" />

    <SolidColorBrush x:Key="StatusDangerBrush" Color="{StaticResource StatusDangerColor}" />
    <SolidColorBrush x:Key="StatusDangerButtonBrush" Color="{StaticResource StatusDangerColor}" />
    <SolidColorBrush x:Key="StatusDangerHoverBrush" Color="{StaticResource StatusDangerHoverColor}" />
    <SolidColorBrush x:Key="StatusDangerPressedBrush" Color="{StaticResource StatusDangerPressedColor}" />
    <SolidColorBrush x:Key="StatusDangerBgBrush" Color="{StaticResource StatusDangerBgColor}" />
    <SolidColorBrush x:Key="StatusDangerBorderBrush" Color="{StaticResource StatusDangerBorderColor}" />

    <SolidColorBrush x:Key="StatusInfoBrush" Color="{StaticResource StatusInfoColor}" />
    <SolidColorBrush x:Key="StatusInfoBgBrush" Color="{StaticResource StatusInfoBgColor}" />
    <SolidColorBrush x:Key="StatusInfoBorderBrush" Color="{StaticResource StatusInfoBorderColor}" />

    <SolidColorBrush x:Key="FocusRingBrush" Color="{StaticResource FocusRingColor}" />
    <SolidColorBrush x:Key="OverlayScrimBrush" Color="{StaticResource OverlayScrimColor}" />
</ResourceDictionary>
