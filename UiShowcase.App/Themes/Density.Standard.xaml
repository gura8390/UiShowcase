<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 标准密度（全偶数 DIP：100%/150%/200% 缩放下均落精确整数物理像素） -->
    <GridLength x:Key="NavWidth">232</GridLength>
    <Thickness x:Key="HeaderPadding">28,18</Thickness>
    <Thickness x:Key="StatusBarPadding">22,10</Thickness>
    <Thickness x:Key="PagePadding">28,22,28,28</Thickness>
    <Thickness x:Key="CardPadding">22</Thickness>
    <!-- 上小下大 2px 光学补偿，且全部为偶数 DIP，150% 下严格对齐物理像素 -->
    <Thickness x:Key="PrimaryButtonPadding">20,8,20,10</Thickness>
    <Thickness x:Key="SecondaryButtonPadding">18,8,18,10</Thickness>
    <Thickness x:Key="InputPadding">12,6,12,8</Thickness>
    <Thickness x:Key="ListItemPadding">14,10,14,12</Thickness>
    <Thickness x:Key="SectionMargin">0,0,0,22</Thickness>
    <Thickness x:Key="RowMargin">0,0,0,14</Thickness>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="ControlMinHeight">38</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="NavItemHeight">42</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="BodyFontSize">14</sys:Double>
</ResourceDictionary>
